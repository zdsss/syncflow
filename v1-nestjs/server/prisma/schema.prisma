generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  OVERDUE
  CANCELLED
  PENDING_ASSIGN
  URGENT
}

enum TaskPriority {
  URGENT
  HIGH
  MEDIUM
  LOW
}

enum ProjectPhase {
  SURVEY
  CONCEPT
  PLANNING
  DEVELOPMENT
  TESTING
  MASS_PRODUCTION
}

enum ProjectStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  DELAYED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FileType {
  DOCUMENT
  IMAGE
  CODE
  SPREADSHEET
  VIDEO
  CAD
  OTHER
}

model User {
  id           String    @id @default(uuid())
  name         String
  avatar       String?
  email        String    @unique
  password     String    @default("")
  phone        String?
  departmentId String    @map("department_id")
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  teams        TeamMember[]
  roles        UserRole[]
  assignedTasks Task[]      @relation("TaskAssignee")
  uploadedFiles File[]
  ledTeams     Team[]       @relation("TeamLeader")
  ledProjects  Project[]    @relation("ProjectLeader")

  @@map("users")
}

model Team {
  id          String   @id @default(uuid())
  name        String
  description String?
  memberCount Int      @default(0) @map("member_count")
  leaderId    String   @map("leader_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  members TeamMember[]
  leader  User?        @relation("TeamLeader", fields: [leaderId], references: [id])

  @@map("teams")
}

model TeamMember {
  id     String @id @default(uuid())
  teamId String @map("team_id")
  userId String @map("user_id")
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@map("team_members")
}

model Department {
  id        String     @id @default(uuid())
  name      String
  parentId  String?    @map("parent_id")
  sortOrder Int?       @map("sort_order")
  roles     Role[]
  users     User[]

  @@map("departments")
}

model Role {
  id           String     @id @default(uuid())
  name         String
  departmentId String     @map("department_id")
  description  String?
  permissions  String[]
  memberCount  Int        @default(0) @map("member_count")
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  users        UserRole[]

  @@map("roles")
}

model UserRole {
  id     String @id @default(uuid())
  userId String @map("user_id")
  roleId String @map("role_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model Project {
  id              String       @id @default(uuid())
  name            String
  description     String?
  parentId        String?      @map("parent_id")
  category        String
  phase           ProjectPhase @default(SURVEY)
  status          ProjectStatus @default(NOT_STARTED)
  leaderId        String       @map("leader_id")
  startDate       DateTime     @map("start_date")
  endDate         DateTime     @map("end_date")
  actualStartDate DateTime?    @map("actual_start_date")
  actualEndDate   DateTime?    @map("actual_end_date")
  completion      Int          @default(0)
  budget          Decimal?     @db.Decimal(12, 2)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  tasks Task[]
  files File[]
  bomItems BomItem[]
  leader User?       @relation("ProjectLeader", fields: [leaderId], references: [id])

  @@index([status])
  @@index([leaderId])
  @@map("projects")
}

model Task {
  id               String       @id @default(uuid())
  name             String
  description      String?
  projectId        String       @map("project_id")
  parentId         String?      @map("parent_id")
  type             String?
  priority         TaskPriority @default(MEDIUM)
  status           TaskStatus   @default(NOT_STARTED)
  assigneeId       String       @map("assignee_id")
  participantIds   String[]     @map("participant_ids")
  planStart        DateTime?    @map("plan_start")
  planEnd          DateTime?    @map("plan_end")
  actualStart      DateTime?    @map("actual_start")
  actualEnd        DateTime?    @map("actual_end")
  plannedHours     Float?       @map("planned_hours")
  loggedHours      Float?       @map("logged_hours")
  progress         Int          @default(0)
  milestone        Boolean      @default(false)
  dependencies     String[]
  reminderStrategy String?      @map("reminder_strategy")
  archiveLocation  String?      @map("archive_location")
  tags             String[]
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee User     @relation("TaskAssignee", fields: [assigneeId], references: [id])
  parent   Task?    @relation("TaskParent", fields: [parentId], references: [id], onDelete: SetNull)
  children Task[]   @relation("TaskParent")

  // Task dependencies: this task depends on other tasks
  dependsOn     TaskDependency[] @relation("TaskDependencyTask")
  // Tasks that depend on this task
  dependedBy    TaskDependency[] @relation("TaskDependencyDependsOn")

  @@index([projectId])
  @@index([assigneeId])
  @@index([status])
  @@index([planEnd])
  @@index([parentId])
  @@map("tasks")
}

// Migration comment: TaskDependency normalized the previous String[] dependencies field
// into a proper relation table. Run `npx prisma migrate dev --name add_task_dependency`
// after merging this change.
model TaskDependency {
  id           String   @id @default(cuid())
  taskId       String   @map("task_id")
  dependsOnId  String   @map("depends_on_id")
  type         String   @default("FS") // SS, SF, FS, FF
  createdAt    DateTime @default(now()) @map("created_at")

  task      Task @relation("TaskDependencyTask", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn Task @relation("TaskDependencyDependsOn", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnId])
  @@index([taskId])
  @@index([dependsOnId])
  @@map("task_dependencies")
}

model File {
  id             String    @id @default(uuid())
  name           String
  type           FileType  @default(OTHER)
  extension      String?
  size           BigInt
  path           String
  parentFolderId String?   @map("parent_folder_id")
  uploaderId     String    @map("uploader_id")
  version        Int       @default(1)
  projectId      String?   @map("project_id")
  downloadCount  Int       @default(0) @map("download_count")
  isDeleted      Boolean   @default(false) @map("is_deleted")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  project  Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploader User     @relation(fields: [uploaderId], references: [id])
  versions FileVersion[]
  permissions FilePermission[]

  @@index([projectId])
  @@index([uploaderId])
  @@index([isDeleted])
  @@map("files")
}

model FileVersion {
  id         String   @id @default(cuid())
  fileId     String   @map("file_id")
  version    Int
  size       Int
  path       String
  uploaderId String   @map("uploader_id")
  comment    String?
  createdAt  DateTime @default(now()) @map("created_at")

  file File @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([fileId])
  @@map("file_versions")
}

// === Phase 3: New Module Models ===

model BomItem {
  id          String    @id @default(uuid())
  name        String
  partNumber  String?   @map("part_number")
  specification String?
  supplier    String?
  unit        String?   @default("pcs")
  unitPrice   Decimal?  @map("unit_price") @db.Decimal(12, 2)
  quantity    Float     @default(1)
  parentId    String?   @map("parent_id")
  projectId   String    @map("project_id")
  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([parentId])
  @@map("bom_items")
}

model BomVersion {
  id          String   @id @default(cuid())
  projectId   String   @map("project_id")
  version     Int
  description String?
  status      String   @default("draft") // draft / published / archived
  creatorId   String?  @map("creator_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([projectId])
  @@unique([projectId, version])
  @@map("bom_versions")
}

model ProcessRoute {
  id          String    @id @default(uuid())
  name        String
  description String?
  projectId   String    @map("project_id")
  status      String    @default("draft")
  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  steps    ProcessStep[]
  versions ProcessVersion[]

  @@index([projectId])
  @@map("process_routes")
}

model ProcessVersion {
  id          String   @id @default(cuid())
  routeId     String
  version     Int
  description String?
  status      String   @default("draft") // draft / approved / published
  createdAt   DateTime @default(now())

  route       ProcessRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@index([routeId])
  @@unique([routeId, version])
  @@map("process_versions")
}

model ProcessStep {
  id           String   @id @default(uuid())
  name         String
  description  String?
  sortOrder    Int      @default(0) @map("sort_order")
  routeId      String   @map("route_id")
  parameters   Json?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  route ProcessRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@index([routeId])
  @@map("process_steps")
}

model Resource {
  id          String    @id @default(uuid())
  name        String
  type        String    // human, equipment, supplier
  description String?
  tags        String[]
  status      String    @default("available")
  metadata    Json?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([type])
  @@index([status])
  @@map("resources")
}

model Article {
  id          String    @id @default(uuid())
  title       String
  content     String    @db.Text
  category    String    @default("general")
  tags        String[]
  status      String    @default("draft")
  authorId    String    @map("author_id")
  viewCount   Int       @default(0) @map("view_count")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([category])
  @@index([status])
  @@map("articles")
}

model Template {
  id          String    @id @default(uuid())
  name        String
  type        String    // project, task
  description String?
  content     Json
  usageCount  Int       @default(0) @map("usage_count")
  creatorId   String    @map("creator_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("templates")
}

model Approval {
  id          String         @id @default(uuid())
  type        String         // task_complete, milestone, bom_change, process_publish, resource_borrow
  targetId    String         @map("target_id")
  targetType  String         @map("target_type")
  status      ApprovalStatus @default(PENDING)
  applicantId String         @map("applicant_id")
  approverId  String?        @map("approver_id")
  comment     String?
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  chain       ApprovalChain[]

  @@index([status])
  @@index([applicantId])
  @@index([approverId])
  @@map("approvals")
}

model ApprovalChain {
  id         String    @id @default(cuid())
  approvalId String    @map("approval_id")
  stepOrder  Int       @map("step_order")
  approverId String    @map("approver_id")
  status     String    @default("pending") // pending / approved / rejected / skipped
  comment    String?
  actedAt    DateTime? @map("acted_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  approval   Approval  @relation(fields: [approvalId], references: [id], onDelete: Cascade)

  @@unique([approvalId, stepOrder])
  @@index([approvalId])
  @@index([approverId])
  @@map("approval_chains")
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String
  action     String   // created / updated / completed / commented / assigned / uploaded
  entityType String   // task / project / file
  entityId   String
  entityName String
  projectId  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([userId])
  @@map("activity_logs")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entityType String
  entityId   String
  changes    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Comment {
  id         String   @id @default(cuid())
  content    String
  authorId   String   @map("author_id")
  entityType String   @map("entity_type") // task / project / file
  entityId   String   @map("entity_id")
  parentId   String?  @map("parent_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([entityType, entityId])
  @@index([authorId])
  @@map("comments")
}

model Notification {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  type        String   // task_assigned / status_changed / approval_updated / system / file_uploaded
  title       String
  content     String
  relatedType String?  @map("related_type") // task / project / file / approval
  relatedId   String?  @map("related_id")
  isRead      Boolean  @default(false) @map("is_read")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

model FilePermission {
  id       String @id @default(cuid())
  fileId   String @map("file_id")
  userId   String @map("user_id")
  level    String @default("view") // view / edit / manage

  file     File   @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([fileId, userId])
  @@index([fileId])
  @@index([userId])
  @@map("file_permissions")
}

model Note {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  title     String
  content   String   @db.Text
  category  String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("notes")
}

model NotificationSetting {
  id            String  @id @default(cuid())
  userId        String  @unique @map("user_id")
  taskReminder  Boolean @default(true) @map("task_reminder")
  emailNotify   Boolean @default(true) @map("email_notify")
  appNotify     Boolean @default(true) @map("app_notify")
  smsNotify     Boolean @default(false) @map("sms_notify")
  reminderDays  Int     @default(3) @map("reminder_days")

  @@map("notification_settings")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}
