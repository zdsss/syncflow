generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  name         String
  avatar       String?
  email        String    @unique
  phone        String?
  departmentId String    @map("department_id")
  status       String    @default("active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  department   Department @relation(fields: [departmentId], references: [id])
  teams        TeamMember[]
  roles        UserRole[]
  assignedTasks Task[]      @relation("TaskAssignee")
  uploadedFiles File[]

  @@map("users")
}

model Team {
  id          String   @id @default(uuid())
  name        String
  description String?
  memberCount Int      @default(0) @map("member_count")
  leaderId    String   @map("leader_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  members TeamMember[]

  @@map("teams")
}

model TeamMember {
  id     String @id @default(uuid())
  teamId String @map("team_id")
  userId String @map("user_id")
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@map("team_members")
}

model Department {
  id        String     @id @default(uuid())
  name      String
  parentId  String?    @map("parent_id")
  sortOrder Int?       @map("sort_order")
  roles     Role[]
  users     User[]

  @@map("departments")
}

model Role {
  id           String     @id @default(uuid())
  name         String
  departmentId String     @map("department_id")
  description  String?
  permissions  String[]
  memberCount  Int        @default(0) @map("member_count")
  department   Department @relation(fields: [departmentId], references: [id])
  users        UserRole[]

  @@map("roles")
}

model UserRole {
  id     String @id @default(uuid())
  userId String @map("user_id")
  roleId String @map("role_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model Project {
  id              String    @id @default(uuid())
  name            String
  description     String?
  parentId        String?   @map("parent_id")
  category        String
  phase           String    @default("survey")
  status          String    @default("not_started")
  leaderId        String    @map("leader_id")
  startDate       DateTime  @map("start_date")
  endDate         DateTime  @map("end_date")
  actualStartDate DateTime? @map("actual_start_date")
  actualEndDate   DateTime? @map("actual_end_date")
  completion      Int       @default(0)
  budget          Decimal?  @db.Decimal(12, 2)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tasks Task[]
  files File[]

  @@map("projects")
}

model Task {
  id               String    @id @default(uuid())
  name             String
  description      String?
  projectId        String    @map("project_id")
  type             String?
  priority         String    @default("medium")
  status           String    @default("not_started")
  assigneeId       String    @map("assignee_id")
  participantIds   String[]  @map("participant_ids")
  planStart        DateTime? @map("plan_start")
  planEnd          DateTime? @map("plan_end")
  actualStart      DateTime? @map("actual_start")
  actualEnd        DateTime? @map("actual_end")
  plannedHours     Float?    @map("planned_hours")
  loggedHours      Float?    @map("logged_hours")
  progress         Int       @default(0)
  milestone        Boolean   @default(false)
  dependencies     String[]
  reminderStrategy String?   @map("reminder_strategy")
  archiveLocation  String?   @map("archive_location")
  tags             String[]
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee User    @relation("TaskAssignee", fields: [assigneeId], references: [id])

  @@map("tasks")
}

model File {
  id             String   @id @default(uuid())
  name           String
  type           String
  extension      String?
  size           BigInt
  path           String
  parentFolderId String?  @map("parent_folder_id")
  uploaderId     String   @map("uploader_id")
  version        Int      @default(1)
  projectId      String?  @map("project_id")
  downloadCount  Int      @default(0) @map("download_count")
  isDeleted      Boolean  @default(false) @map("is_deleted")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  project  Project? @relation(fields: [projectId], references: [id])
  uploader User     @relation(fields: [uploaderId], references: [id])

  @@map("files")
}
