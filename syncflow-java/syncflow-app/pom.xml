<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.syncflow</groupId>
        <artifactId>syncflow-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>syncflow-app</artifactId>
    <name>SyncFlow Application</name>
    <description>Main Spring Boot application entry point</description>

    <dependencies>
        <dependency>
            <groupId>com.syncflow</groupId>
            <artifactId>syncflow-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.syncflow</groupId>
            <artifactId>syncflow-admin</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.syncflow</groupId>
            <artifactId>syncflow-project</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.syncflow</groupId>
            <artifactId>syncflow-task</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.syncflow</groupId>
            <artifactId>syncflow-bom</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.syncflow</groupId>
            <artifactId>syncflow-process</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.syncflow</groupId>
            <artifactId>syncflow-config</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.syncflow</groupId>
            <artifactId>syncflow-file</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.syncflow</groupId>
            <artifactId>syncflow-workflow</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.syncflow</groupId>
            <artifactId>syncflow-statistics</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.syncflow</groupId>
            <artifactId>syncflow-message</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- JWT -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
        </dependency>

        <!-- Security -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- WebSocket -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>

        <!-- Knife4j -->
        <dependency>
            <groupId>com.github.xiaoymin</groupId>
            <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
        </dependency>

        <!-- CSV -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-csv</artifactId>
            <version>1.12.0</version>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.syncflow</groupId>
            <artifactId>syncflow-common</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.syncflow.SyncFlowApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
